# ─── YtVidSave Environment Variables ─────────────────────────────────────────
# Copy this file to .env.local and adjust values as needed.
# Never commit .env.local to version control.

# yt-dlp binary path (leave empty to use system PATH)
YT_DLP_PATH=

# Timeouts in milliseconds
ANALYZE_TIMEOUT=20000
DOWNLOAD_TIMEOUT=300000

# Rate limits (per minute per IP)
RATE_LIMIT_ANALYZE=10
RATE_LIMIT_DOWNLOAD=3

# Resource limits
MAX_CONCURRENT_DOWNLOADS=2
MAX_FILE_SIZE_MB=500

# Site URL (used for SEO metadata)
NEXT_PUBLIC_SITE_URL=https://ytvidsave.com
